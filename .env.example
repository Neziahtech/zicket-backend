NODE_ENV=development/production
PORT=3000
MONGO_URI=MONGO_DB_CLUSTER
JWT_SECRET=your_jwt_secret
JWT_EXPIRATION=8h
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
FRONTEND_URL=http://localhost:3000
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@zicket.com
ATTENDANCE_NULLIFIER_PEPPER=your_attendance_nullifier_pepper
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# ── Blockchain / Payment ──────────────────────────────────────────────────────
BLOCKCHAIN_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_key
PLATFORM_WALLET_ADDRESS=0xYourPlatformWalletAddress
MIN_CONFIRMATIONS=2
# Payment asset pricing (USD → on-chain base units). Asset-agnostic.
PAYMENT_ASSET=ETH
PAYMENT_ASSET_DECIMALS=18
# Acceptable underpayment variance in basis points (100 = 1%)
PAYMENT_TOLERANCE_BPS=100
# Optional override for price endpoint (JSON with usd / usdPerAsset / {id:{usd}})
# PRICE_API_URL=https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd
PRICE_CACHE_TTL_MS=60000
# Last-resort USD-per-asset when live pricing fails (required for offline/dev)
FALLBACK_USD_PER_ASSET=2500
# ── Data retention / anonymization (#127) ─────────────────────────────────────
RETENTION_CRON="0 3 * * *"
WEBHOOK_SECRET=your_hmac_webhook_secret
# ── Queue / Redis ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# ── Reconciliation ────────────────────────────────────────────────────────────
RECONCILIATION_STALE_MINUTES=30
RECONCILIATION_CRON=*/15 * * * *
# ── Soroban / Payments contract (proportional cancellation reads) ─────────────
EVENT_CONTRACT_ID=C...
PAYMENTS_CONTRACT_ID=C...
SOROBAN_ATTEND_SIGNER_SECRET=S...
SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
ZKPASSPORT_MOCK_VERIFY=false
ZKPASSPORT_RELAY_URL=
